---
import { V2_OUTRO } from '../../data/conceptsV2';
const base = import.meta.env.BASE_URL;
---
<section class="v2-outro" data-slide data-reveal-root>
  <div class="bg" aria-hidden="true">
    <span class="kanji">了</span>
  </div>
  <div class="fore container">
    <h2 class="title" data-reveal="title">{V2_OUTRO.title}</h2>
    <p class="body" data-reveal="evidence">{V2_OUTRO.body}</p>
    <div class="links" data-reveal="takeaway">
      <a class="back-link" href={base}>← all versions</a>
      <a class="v1-link" href={`${base}v1`}>{V2_OUTRO.v1Link}</a>
    </div>
  </div>
</section>

<style>
  .v2-outro {
    position: relative;
    min-height: 80svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: clamp(4rem, 10vh, 7rem) 0;
  }
  .bg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transform: translate3d(0, calc(var(--p, 0) * 60px), 0);
  }
  .kanji {
    font-family: 'Shippori Mincho', serif;
    font-weight: 700;
    color: var(--yellow-hi);
    font-size: clamp(20rem, 60vw, 44rem);
    line-height: 0.85;
    opacity: 0.05;
  }
  .fore {
    position: relative;
    display: grid;
    gap: 1.4rem;
    max-width: 50rem;
  }
  .title {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1.0;
  }
  .body {
    color: var(--ink-mute);
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    max-width: 38ch;
    margin: 0;
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }
  .back-link, .v1-link {
    color: var(--ink-mute);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .back-link:hover, .v1-link:hover {
    color: var(--yellow-hi);
    text-decoration: none;
  }
  .v1-link { color: var(--ink-dim); }

  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }
  .v2-outro.is-visible [data-reveal] {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .v2-outro.is-visible [data-reveal="title"]    { transition-delay: 0ms; }
  .v2-outro.is-visible [data-reveal="evidence"] { transition-delay: 160ms; }
  .v2-outro.is-visible [data-reveal="takeaway"] { transition-delay: 320ms; }

  @media (prefers-reduced-motion: reduce) {
    .bg { transform: none !important; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
