---
export interface Props {
  name: string;
}
const { name } = Astro.props;
---
<svg class="motif" viewBox="0 0 200 200" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  {name === 'kaizen' && (
    <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
      <circle cx="100" cy="100" r="22" opacity="0.85" />
      <circle cx="100" cy="100" r="42" opacity="0.65" />
      <circle cx="100" cy="100" r="62" opacity="0.45" />
      <circle cx="100" cy="100" r="82" opacity="0.28" />
      <circle cx="100" cy="100" r="98" opacity="0.14" />
    </g>
  )}

  {name === 'ikigai' && (
    <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55">
      <circle cx="80" cy="80" r="50" />
      <circle cx="120" cy="80" r="50" />
      <circle cx="80" cy="120" r="50" />
      <circle cx="120" cy="120" r="50" />
    </g>
  )}

  {name === 'harahachi' && (
    <g>
      <defs>
        <clipPath id="hh-clip"><circle cx="100" cy="100" r="72" /></clipPath>
      </defs>
      <circle cx="100" cy="100" r="72" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.75" />
      <rect x="28" y="40" width="144" height="115" fill="currentColor" opacity="0.18" clip-path="url(#hh-clip)" />
    </g>
  )}

  {name === 'shinrin' && (
    <g stroke="currentColor" stroke-linecap="round" fill="none">
      <line x1="40"  y1="160" x2="40"  y2="60"  stroke-width="2" opacity="0.35" />
      <line x1="68"  y1="160" x2="68"  y2="38"  stroke-width="2" opacity="0.55" />
      <line x1="96"  y1="160" x2="96"  y2="50"  stroke-width="2" opacity="0.85" />
      <line x1="124" y1="160" x2="124" y2="32"  stroke-width="2" opacity="0.65" />
      <line x1="152" y1="160" x2="152" y2="64"  stroke-width="2" opacity="0.45" />
      <line x1="180" y1="160" x2="180" y2="80"  stroke-width="2" opacity="0.25" />
    </g>
  )}

  {name === 'wabisabi' && (
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path
        d="M 100 28
           C 142 28, 172 60, 172 100
           C 172 138, 140 168, 100 170
           C 60 170, 32 140, 30 100
           C 30 62, 60 30, 100 30"
        stroke-width="6" opacity="0.85"
      />
    </g>
  )}

  {name === 'gaman' && (
    <g fill="currentColor">
      <ellipse cx="100" cy="160" rx="60" ry="10" opacity="0.6" />
      <ellipse cx="100" cy="138" rx="44" ry="9"  opacity="0.5" />
      <ellipse cx="100" cy="118" rx="32" ry="8"  opacity="0.4" />
      <ellipse cx="100" cy="100" rx="22" ry="7"  opacity="0.3" />
      <ellipse cx="100" cy="84"  rx="14" ry="6"  opacity="0.22" />
    </g>
  )}

  {name === 'omoiyari' && (
    <g fill="none" stroke="currentColor">
      <circle cx="80"  cy="100" r="28" stroke-width="1.4" opacity="0.85" />
      <circle cx="80"  cy="100" r="48" stroke-width="1"   opacity="0.5" />
      <circle cx="80"  cy="100" r="72" stroke-width="0.8" opacity="0.25" />
      <circle cx="120" cy="100" r="28" stroke-width="1.4" opacity="0.85" />
      <circle cx="120" cy="100" r="48" stroke-width="1"   opacity="0.5" />
      <circle cx="120" cy="100" r="72" stroke-width="0.8" opacity="0.25" />
    </g>
  )}

  {name === 'kintsugi' && (
    <g stroke="currentColor" fill="none" stroke-linecap="round">
      <path d="M 30 100 L 80 92 L 110 116 L 150 96 L 180 110" stroke-width="1.5" opacity="0.85" />
      <path d="M 80 92  L 76 60" stroke-width="1.2" opacity="0.65" />
      <path d="M 110 116 L 120 150" stroke-width="1.2" opacity="0.65" />
      <path d="M 150 96 L 158 70" stroke-width="1" opacity="0.45" />
    </g>
  )}
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
    color: var(--accent, var(--ink));
    display: block;
  }
</style>
