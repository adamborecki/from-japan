---
import { CONCEPTS_V2 } from '../../data/conceptsV2';
---
<nav class="v2-nav" aria-label="Concepts">
  <ol>
    {CONCEPTS_V2.map((c) => (
      <li>
        <a href={`#${c.slug}`} data-target={c.slug} style={`--accent: ${c.accent}`}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{c.name}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.v2-nav a[data-target]');
  const map = new Map<string, HTMLAnchorElement>();
  links.forEach((a) => {
    const target = a.dataset.target;
    if (target) map.set(target, a);
  });

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const id = e.target.id;
        const link = map.get(id);
        if (!link) continue;
        if (e.isIntersecting && e.intersectionRatio > 0.4) {
          links.forEach((l) => l.classList.remove('is-current'));
          link.classList.add('is-current');
        }
      }
    },
    { threshold: [0.4, 0.6] }
  );

  for (const id of map.keys()) {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  }
</script>

<style>
  .v2-nav {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
  }
  .v2-nav ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .v2-nav a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink-dim);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.25s;
  }
  .v2-nav a:hover { color: var(--ink); text-decoration: none; }
  .v2-nav a:hover .label { opacity: 1; transform: translateX(0); }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--ink-dim) 80%, transparent);
    background: transparent;
    transition: background 0.25s, transform 0.25s, border-color 0.25s;
  }
  .label {
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
  }
  .v2-nav a.is-current { color: var(--ink); }
  .v2-nav a.is-current .dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.3);
  }
  .v2-nav a.is-current .label {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .v2-nav { display: none; }
  }
</style>
