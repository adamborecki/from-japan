---
import type { ConceptV2 } from '../../data/conceptsV2';
import Motif from './Motif.astro';

export interface Props {
  concept: ConceptV2;
}
const { concept } = Astro.props;

function shortAuthors(authors: string): string {
  // Collapse a long author list to "FirstAuthor et al." for the citation pill
  const parts = authors.split(',').map((s) => s.trim()).filter(Boolean);
  if (parts.length <= 2) return authors;
  return `${parts[0]} et al.`;
}
---
<section
  class="slide"
  id={concept.slug}
  data-slide
  style={`--accent: ${concept.accent}`}
  aria-labelledby={`${concept.slug}-title`}
>
  <div class="layer layer-back" aria-hidden="true">
    <span class="kanji">{concept.romaji}</span>
  </div>

  <div class="layer layer-mid" aria-hidden="true">
    <div class="backdrop"></div>
    <div class="motif-wrap">
      <Motif name={concept.motif} />
    </div>
  </div>

  <div class="layer layer-fore">
    <div class="slide-inner container">
      <div class="numeral" data-reveal="numeral">
        <span class="num">0{concept.n}</span>
        <span class="rule"></span>
        <span class="of">of 08</span>
      </div>

      <header class="slide-head" data-reveal="title">
        <h2 id={`${concept.slug}-title`} class="title">
          <span class="name">{concept.name}</span>
          <span class="translation">{concept.translation}</span>
        </h2>
        <p class="tagline">{concept.tagline}</p>
      </header>

      <article class="evidence" data-reveal="evidence">
        <p class="science">{concept.science}</p>
        <a class="citation-pill" href={concept.citation.url} target="_blank" rel="noopener noreferrer">
          <span class="cit-authors">{shortAuthors(concept.citation.authors)} ({concept.citation.year})</span>
          <span class="cit-journal">{concept.citation.journal}, {concept.citation.volumePages}</span>
          <span class="cit-arrow" aria-hidden="true">↗</span>
        </a>
      </article>

      <aside class="takeaway" data-reveal="takeaway">
        <span class="takeaway-label">try it</span>
        <p>{concept.takeaway}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .slide {
    position: relative;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(4rem, 10vh, 7rem) 0;
    display: flex;
    align-items: center;
  }

  .layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .layer-fore { position: relative; pointer-events: auto; width: 100%; }

  .layer-back {
    transform: translate3d(0, calc(var(--p, 0) * 90px), 0);
    will-change: transform;
  }
  .kanji {
    font-family: 'Shippori Mincho', 'Fraunces', serif;
    font-weight: 700;
    font-size: clamp(16rem, 50vw, 38rem);
    line-height: 0.85;
    color: var(--ink);
    opacity: 0.06;
    user-select: none;
    white-space: nowrap;
  }

  .layer-mid {
    transform: translate3d(0, calc(var(--p, 0) * 40px), 0);
    will-change: transform;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 45%,
        color-mix(in oklab, var(--accent) 22%, transparent) 0%,
        transparent 70%),
      radial-gradient(40% 40% at 80% 80%,
        color-mix(in oklab, var(--accent) 10%, transparent) 0%,
        transparent 60%);
  }
  .motif-wrap {
    position: relative;
    width: clamp(20rem, 60vmin, 36rem);
    aspect-ratio: 1;
    opacity: 0.55;
  }

  .layer-fore {
    transform: translate3d(0, calc(var(--p, 0) * -28px), 0);
    will-change: transform;
  }

  .slide-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vh, 2rem);
    max-width: 56rem;
  }

  .numeral {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--ink-mute);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .num { color: var(--accent); font-weight: 600; }
  .rule {
    flex: 0 0 3rem;
    height: 1px;
    background: color-mix(in oklab, var(--accent) 65%, transparent);
  }
  .of { color: var(--ink-dim); }

  .slide-head { display: grid; gap: 0.6rem; }
  .title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .name {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1.0;
    color: var(--ink);
  }
  .translation {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  .tagline {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--accent);
    margin: 0.4rem 0 0 0;
    max-width: 32ch;
  }

  .evidence {
    background: color-mix(in oklab, var(--bg-soft) 80%, transparent);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    padding: clamp(1.1rem, 2vw, 1.6rem);
    border-radius: var(--radius);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .science {
    margin: 0 0 1rem 0;
    color: var(--ink);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.6;
  }
  .citation-pill {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink-mute);
    font-size: 0.78rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .citation-pill:hover {
    border-color: var(--accent);
    color: var(--ink);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .cit-authors { color: var(--ink); font-weight: 500; }
  .cit-journal { font-style: italic; }
  .cit-arrow { color: var(--accent); font-size: 0.9rem; }

  .takeaway {
    border: 1px dashed color-mix(in oklab, var(--accent) 60%, var(--line));
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }
  .takeaway-label {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .takeaway p {
    margin: 0;
    color: var(--ink);
    font-family: 'Fraunces', serif;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
  }

  /* Reveal targets — JS adds .is-visible to the slide on enter. */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }
  .slide.is-visible [data-reveal] {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .slide.is-visible [data-reveal="numeral"]   { transition-delay: 0ms; }
  .slide.is-visible [data-reveal="title"]     { transition-delay: 120ms; }
  .slide.is-visible [data-reveal="evidence"]  { transition-delay: 280ms; }
  .slide.is-visible [data-reveal="takeaway"]  { transition-delay: 440ms; }

  @media (max-width: 720px) {
    .layer-back { transform: translate3d(0, calc(var(--p, 0) * 50px), 0); }
    .layer-mid  { transform: translate3d(0, calc(var(--p, 0) * 22px), 0); }
    .layer-fore { transform: translate3d(0, calc(var(--p, 0) * -14px), 0); }
    .motif-wrap { opacity: 0.4; }
    .kanji      { opacity: 0.05; }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer-back, .layer-mid, .layer-fore { transform: none !important; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
