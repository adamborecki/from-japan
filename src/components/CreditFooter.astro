---
import { VIDEO } from '../data/habits';
---
<footer class="credit-footer">
  <div class="footer-inner container">
    <div class="col">
      <p class="eyebrow">About this page</p>
      <p class="about">
        This is a web-app adaptation of a YouTube video — every word, frame, and idea on this page comes from the source video below. It was built as a demo of what you can vibecode when you let a great piece of video become a great piece of web.
      </p>
    </div>
    <div class="col">
      <p class="eyebrow">Original video</p>
      <p class="video-title">
        <a href={VIDEO.url} target="_blank" rel="noopener noreferrer">{VIDEO.title}</a>
      </p>
      <p class="video-by">
        by <a href={VIDEO.channelUrl} target="_blank" rel="noopener noreferrer">{VIDEO.channel}</a>
      </p>
      <a class="watch-full" href={VIDEO.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        Watch the full video on YouTube
      </a>
    </div>
    <div class="col colophon">
      <p class="eyebrow">Colophon</p>
      <p class="tiny">
        Words, images, and ideas: from the video above, used with credit and a link back to the source.<br/>
        Built with Astro, deployed via GitHub Pages, typeset in Fraunces & Inter (with a little Shippori Mincho for the kanji).
      </p>
      <p class="tiny">
        <a href="https://github.com/adamborecki/from-japan" target="_blank" rel="noopener noreferrer">View the source on GitHub →</a>
      </p>
    </div>
  </div>
  <div class="footer-bar">
    <div class="container bar-inner">
      <span class="mark"><span class="kanji">日</span> from&nbsp;japan</span>
      <span class="tag">A video converted into a webapp</span>
    </div>
  </div>
</footer>

<style>
  .credit-footer {
    margin-top: clamp(3rem, 8vh, 6rem);
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 820px) {
    .footer-inner { grid-template-columns: 1.2fr 1fr 1fr; gap: 2.5rem; }
  }
  .eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-dim);
    margin: 0 0 0.5rem 0;
  }
  .about { color: var(--ink-mute); font-size: 0.95rem; line-height: 1.6; margin: 0; max-width: 48ch; }
  .video-title { margin: 0 0 0.25rem 0; font-family: 'Fraunces', serif; font-size: 1.05rem; line-height: 1.3; }
  .video-title a { color: var(--ink); }
  .video-by { margin: 0 0 0.75rem 0; color: var(--ink-mute); font-size: 0.9rem; }
  .video-by a { color: var(--yellow-hi); }
  .watch-full {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: var(--yellow);
    color: #1b1714;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .watch-full:hover { text-decoration: none; }

  .tiny { color: var(--ink-mute); font-size: 0.82rem; line-height: 1.55; margin: 0 0 0.6rem 0; }
  .colophon a { color: var(--ink-mute); }
  .colophon a:hover { color: var(--yellow-hi); }

  .footer-bar {
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }
  .bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.78rem;
    color: var(--ink-dim);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    color: var(--ink);
  }
  .kanji {
    font-family: 'Shippori Mincho', serif;
    color: var(--yellow-hi);
  }
  .tag { font-style: italic; }
</style>
