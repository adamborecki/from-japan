---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'from-japan \u2014 a video converted into a webapp',
  description = 'Eight tiny Japanese habits that make a massive difference. A web-app adaptation of a YouTube video by @WutNexLev.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1b1714" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6efe4" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}frames/hero-a.jpg`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E6%97%A5%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@400;500;600&family=Shippori+Mincho:wght@500;700&display=swap" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --bg:        #1b1714;
        --bg-soft:   #221d19;
        --bg-elev:   #2a221c;
        --ink:       #f5ecde;
        --ink-mute:  #bfb19f;
        --ink-dim:   #8a7d6d;
        --line:      rgba(245,236,222,0.12);
        --line-soft: rgba(245,236,222,0.06);

        --yellow:    #f3c042;
        --yellow-hi: #ffd566;
        --sky:       #9bc7d7;
        --sage:      #b6ccae;
        --wood:      #b8864e;
        --rose:      #d89a8b;
        --gold:      #e0a949;

        --max:   68rem;
        --gutter: clamp(1rem, 4vw, 2.5rem);
        --radius: 14px;
        --radius-lg: 22px;
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg:        #f6efe4;
          --bg-soft:   #fbf7ee;
          --bg-elev:   #ffffff;
          --ink:       #1b1714;
          --ink-mute:  #4a4036;
          --ink-dim:   #7a6f62;
          --line:      rgba(27,23,20,0.12);
          --line-soft: rgba(27,23,20,0.06);

          --yellow:    #e9b12d;
          --yellow-hi: #f3c042;
          --sky:       #6ea7bb;
          --sage:      #89a786;
          --wood:      #b8864e;
          --rose:      #c07d6c;
          --gold:      #b8864e;
        }
      }

      * { box-sizing: border-box; }

      html {
        background: var(--bg);
        color: var(--ink);
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        letter-spacing: -0.005em;
        background: var(--bg);
        color: var(--ink);
        overflow-x: hidden;
      }

      @media (min-width: 768px) { body { font-size: 18px; } }

      a {
        color: var(--yellow-hi);
        text-decoration: none;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      a:hover { text-decoration: underline; }

      h1, h2, h3, h4 {
        font-family: 'Fraunces', 'Shippori Mincho', Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin: 0;
        color: var(--ink);
      }

      h1 { font-size: clamp(2.4rem, 6.5vw, 5rem); font-variation-settings: 'opsz' 120; }
      h2 { font-size: clamp(1.8rem, 4.5vw, 3rem);  font-variation-settings: 'opsz' 96;  }
      h3 { font-size: clamp(1.2rem, 2.8vw, 1.6rem); }

      p { margin: 0 0 1rem 0; }
      p + p { margin-top: 0.25rem; }

      img { max-width: 100%; display: block; }

      ::selection { background: var(--yellow); color: #1b1714; }

      .container {
        width: 100%;
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }

      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        border: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
